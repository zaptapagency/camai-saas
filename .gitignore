# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ML weights & media (never commit these)
*.pt
*.onnx
*.engine
*.mp4
*.avi
*.mkv
clips/
snapshots/

# Node / Next.js
node_modules/
.next/
out/
dist/

# Env & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.csr
device-cert*
# Per-device mTLS identity minted on first boot (key/cert/csr) — never commit.
device/

# Local edge state / runtime DBs (SQLite dev stores, queues, registries)
event-queue.db
*.sqlite
*.db
*.log

# Accuracy-flywheel runtime artifacts: captured frames + sidecars, fine-tune
# datasets and training run outputs. Data/outputs, never source.
capture/
retrain_out/
runs/

# Demo configs containing time-signed live-stream URLs (generated at runtime).
packages/edge-agent/demo-live*.yaml

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Generated demo fleet spec (from tools/generate_demo_fleet.py)
packages/edge-agent/demo-master-fleet.cams.yaml

# Generated / local demo run configs
packages/edge-agent/demo-run.yaml
packages/edge-agent/demo-run.cams.yaml
packages/edge-agent/demo-master-caltrans.yaml
packages/edge-agent/caltrans-run.yaml

# CamAI deploy environment — copy to .env and fill in. NEVER commit real secrets.

# --- Dashboard (Next.js) ----------------------------------------------------
# Signing secret for NextAuth sessions. Generate one: `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Public URL the dashboard is served at (used by NextAuth for callbacks).
NEXTAUTH_URL=http://localhost:3000
# The cloud API origin the dashboard's /v1/* proxy targets. In docker-compose
# this is http://cloud:8000; for a split deploy use the public cloud URL. NOTE:
# it is baked at BUILD time, so set it when building the dashboard image.
CAMAI_API_ORIGIN=http://cloud:8000
# Optional real SSO (replaces the demo Credentials provider when set):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloud API (FastAPI) ----------------------------------------------------
# sqlite (default, dev) | postgres (production). For postgres also set the DSN.
CAMAI_STORE=sqlite
CAMAI_PG_DSN=postgresql://camai:changeme@db:5432/camai
POSTGRES_PASSWORD=changeme
# Enforce cert-derived device identity on ingest (behind a TLS proxy) in prod.
CAMAI_REQUIRE_MTLS=0
# Stripe metered billing (leave empty to disable billing jobs).
STRIPE_API_KEY=

# Base URL of the CamAI cloud API (the FastAPI app in packages/cloud).
# The dashboard reads the same endpoints the served SPA uses:
#   GET /v1/tenants/{id}/summary | /events | /devices | /usage
# Leave unset to default to same-origin ("") — useful when the dashboard is
# reverse-proxied in front of the API. Set it explicitly for local dev.
NEXT_PUBLIC_CAMAI_API_BASE=http://localhost:8000
